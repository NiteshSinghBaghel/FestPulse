# -----------------------------------------------------------------------------
# FestPulse / CampusPass - Environment Template (.env.example)
# -----------------------------------------------------------------------------

# Razorpay Payment Gateway Credentials
# Get these from your Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# For testing: starts with rzp_test_...
# For real live transactions: starts with rzp_live_...
RAZORPAY_KEY_ID=rzp_test_YourKeyId
RAZORPAY_KEY_SECRET=YourKeySecret

# Public key ID for browser checkout (must match RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyId

# Optional: Razorpay Webhook Secret
RAZORPAY_WEBHOOK_SECRET=

# Optional: RazorpayX Virtual / Current Account Number for automated Host Payouts
RAZORPAY_ACCOUNT_NUMBER=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net
MONGODB_DB_NAME=festpulse

# Vercel Environment Variables
# Add RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, MONGODB_URI and MONGODB_DB_NAME in
# Vercel Project Settings -> Environment Variables for Production and Preview.
# Permanent Cloud Database (Free PostgreSQL — Neon.tech / Supabase / Render Postgres)
# Paste your PostgreSQL connection string below to permanently store events, tickets, accounts, payments & payouts
DATABASE_URL=
