# Razorpay Payment Gateway Credentials
# Generate in Razorpay Dashboard: Settings > API Keys
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# RazorpayX Payouts Account Number (Optional — required for on-demand organizer IMPS/UPI payouts)
RAZORPAY_ACCOUNT_NUMBER=

# Razorpay Webhook Secret (Optional — for signed webhook verification)
RAZORPAY_WEBHOOK_SECRET=
